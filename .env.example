# Database settings
DB_PATH=data/autopilot.db

# AI Services
OLLAMA_URL=http://localhost:11434

# --- GigaChat API (тариф Premium) ---
# Основные переменные (Шаг 1 интеграции):
GIGACHAT_CLIENT_ID=your_gigachat_client_id_here
GIGACHAT_CLIENT_SECRET=your_gigachat_client_secret_here
# OAuth scope: GIGACHAT_API_PERS (физ. лицо), GIGACHAT_API_CORP (юр. лицо) или GIGACHAT_API_B2B
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модели Premium-тарифа: GigaChat-Pro / GigaChat-Max (текст), GigaChat (изображения)
GIGACHAT_TEXT_MODEL=GigaChat-Pro
GIGACHAT_IMAGE_MODEL=GigaChat
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# URL сервиса авторизации OAuth 2.0 (порт 9443!)
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Проверка SSL-сертификата. По умолчанию false: сертификаты Sber — нестандартная
# цепочка, на Linux (Fedora и др.) иначе падает CERTIFICATE_VERIFY_FAILED.
GIGACHAT_VERIFY_SSL=false
# Устаревшие имена (совместимость): если GIGACHAT_CLIENT_ID/SECRET не заданы,
# используются эти значения как client_id/client_secret
GIGACHAT_KEY=your_gigachat_key_here
GIGACHAT_SECRET=your_gigachat_secret_here

# VKontakte settings
# VK_TOKEN/VK_GROUP_ID используются фоновым планировщиком (services/scheduler.py)
# для автопубликации. Ручная публикация через CommunityManager берёт токены из БД.
VK_TOKEN=your_vk_token_here
VK_GROUP_ID=your_vk_group_id_here
# Зарезервировано под будущую авторизацию через ВКонтакте (OAuth). Текущим кодом не используется.
VK_CLIENT_ID=your_vk_client_id_here
VK_CLIENT_SECRET=your_vk_client_secret_here
VK_REDIRECT_URI=http://127.0.0.1:8000/auth/vk/callback

# Telegram settings (зарезервировано под будущего Telegram-бота, сейчас не используется)
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_PROXY_URL=

# Logging
LOG_LEVEL=INFO
